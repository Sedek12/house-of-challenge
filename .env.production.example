APP_NAME="OCD Live"
APP_ENV=production
APP_KEY=                         # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://votre-domaine.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=Africa/Lome

LOG_CHANNEL=stack
LOG_LEVEL=warning
SENTRY_LARAVEL_DSN=              # optionnel

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=house_of_challenge
DB_USERNAME=hoc
DB_PASSWORD=                     # mot de passe fort
DB_ROOT_PASSWORD=                # utilisé par le conteneur MySQL uniquement

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Admin initial (créé au premier démarrage, mot de passe jamais écrasé ensuite)
ADMIN_EMAIL=
# Entre guillemets si le mot de passe contient « # » ou des espaces. 12 caractères minimum.
ADMIN_PASSWORD=
SEED_DEMO=false

# Paiement : mock (interdit en prod) | fedapay | cinetpay
PAYMENT_PROVIDER=fedapay
PAYMENT_ENV=sandbox              # passer à live après validation par le porteur du projet
PAYMENT_PUBLIC_KEY=              # cinetpay : site_id
PAYMENT_SECRET_KEY=              # fedapay : clé secrète ; cinetpay : apikey
PAYMENT_WEBHOOK_SECRET=          # fedapay : secret du webhook

CRON_SECRET=                     # si les tâches sont déclenchées par un cron HTTP externe

MAIL_MAILER=smtp                 # ou resend
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@votre-domaine.com
MAIL_FROM_NAME="OCD Live"

