# Environnement des tests PHP (php artisan test) : base locale dédiée, paiement simulé, e-mails en mémoire.
# Ce fichier remplace .env pendant les tests : ils ne touchent donc JAMAIS la base, le paiement ou le serveur d'e-mail réels.
# Aucun secret ici (la clé ci-dessous ne sert qu'aux tests). Adaptez DB_USERNAME / DB_PASSWORD si votre MySQL local en a besoin.
APP_NAME="OCD Live"
APP_ENV=testing
APP_KEY=base64:MZwm/d99msaUnJ4+GnRXjz4oWbNqqseylDj1qkkL4Sk=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
DISPLAY_TIMEZONE=Africa/Lome

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=house_of_challenge_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
MAIL_FROM_ADDRESS="test@ocdlive.test"
MAIL_FROM_NAME="OCD Live"
BCRYPT_ROUNDS=4
LOG_CHANNEL=single

PAYMENT_PROVIDER=mock
PAYMENT_ENV=sandbox
PAYMENT_WEBHOOK_SECRET=test-webhook-secret
CRON_SECRET=
# Les tests partent d'une base propre : pas de vendeurs ni de réservations de démonstration.
SEED_DEMO_DATA=false
ADMIN_EMAIL=admin@ocdlive.test
ADMIN_PASSWORD="Admin#12345"
